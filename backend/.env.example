# OrderFlow environment config
# Copy this file to `.env` in the backend folder and fill in values as needed.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092

# Service ports
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# SMTP for critical alert emails
# Example for Gmail app-password auth:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your-address@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
