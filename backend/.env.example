# ─────────────────────────────────────────────────────────────
# OrderFlow — Distributed Order System  |  Environment Config
# Copy this file to .env and replace values as needed.
# ─────────────────────────────────────────────────────────────

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres

# Redis (Docker — no password needed for local dev)
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=kafka:9092

# Service Ports
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
